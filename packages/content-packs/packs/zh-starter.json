  "cards": [
    { "id": "A01", "cardType": "recall-output", "skillId": "greet", "context": "You join the campus language-exchange table. A Chinese student sits down across from you. Greet them.", "target": "你好！", "hints": ["Nǐ…", "你好 (Nǐ hǎo)…"], "ext": { "lang": { "pinyin": "Nǐ hǎo!", "literalGloss": "You good!" } } },
    { "id": "A02", "cardType": "recall-output", "skillId": "ask-name", "context": "You've chatted for a minute and realize you never got their name. Ask.", "target": "你叫什么名字？", "hints": ["Nǐ jiào…", "你叫什么… (Nǐ jiào shénme…)"], "ext": { "lang": { "pinyin": "Nǐ jiào shénme míngzi?", "literalGloss": "You called what name?" } } },
    { "id": "A03", "cardType": "recall-output", "skillId": "say-name", "context": "Your exchange partner asks for your name. Tell them.", "target": "我叫 Anna。", "hints": ["Wǒ jiào…", "我叫 A… (Wǒ jiào A…)"], "ext": { "lang": { "pinyin": "Wǒ jiào Anna.", "literalGloss": "I am-called Anna." } } },
    { "id": "A04", "cardType": "recall-output", "skillId": "nationality", "context": "A shopkeeper asks 你是哪国人? Tell them you're American.", "target": "我是美国人。", "hints": ["Wǒ shì…", "我是美国… (Wǒ shì Měiguó…)"], "ext": { "lang": { "pinyin": "Wǒ shì Měiguórén.", "literalGloss": "I am America-person." } } },
    { "id": "A05", "cardType": "recall-output", "skillId": "nice-to-meet", "context": "Your first conversation went well and you're wrapping up. Say you're glad to have met them.", "target": "认识你很高兴！", "hints": ["Rènshi…", "认识你… (Rènshi nǐ…)"], "ext": { "lang": { "pinyin": "Rènshi nǐ hěn gāoxìng!", "literalGloss": "Know you very happy!" } } },
    { "id": "A06", "cardType": "recall-output", "skillId": "im-fine", "context": "A friend greets you with 你好吗? Answer that you're fine and thank them.", "target": "我很好，谢谢！", "hints": ["Wǒ hěn…", "我很好… (Wǒ hěn hǎo…)"], "ext": { "lang": { "pinyin": "Wǒ hěn hǎo, xièxie!", "literalGloss": "I very good, thanks!" } } },
    { "id": "A07", "cardType": "recall-output", "skillId": "see-tomorrow", "context": "Chinese class is over; you'll see everyone again tomorrow. Say bye accordingly.", "target": "明天见！", "hints": ["Míng…", "明天… (Míngtiān…)"], "ext": { "lang": { "pinyin": "Míngtiān jiàn!", "literalGloss": "Tomorrow see!" } } },
    { "id": "A08", "cardType": "recall-output", "skillId": "studying-x", "context": "A family friend asks what language you're studying these days.", "target": "我在学中文。", "hints": ["Wǒ zài…", "我在学… (Wǒ zài xué…)"], "ext": { "lang": { "pinyin": "Wǒ zài xué Zhōngwén.", "literalGloss": "I (in-middle-of) study Chinese." } } },
    { "id": "A09", "cardType": "recall-output", "skillId": "what-is-this", "context": "Your teacher holds up a flashcard with something you don't recognize. Ask what it is.", "target": "这是什么？", "hints": ["Zhè…", "这是… (Zhè shì…)"], "ext": { "lang": { "pinyin": "Zhè shì shénme?", "literalGloss": "This is what?" } } },
    { "id": "A10", "cardType": "recall-output", "skillId": "how-to-say", "context": "You point at your backpack and want to know its Chinese word.", "target": "这个中文怎么说？", "hints": ["Zhège…", "这个中文… (Zhège Zhōngwén…)"], "ext": { "lang": { "pinyin": "Zhège Zhōngwén zěnme shuō?", "literalGloss": "This-one Chinese how say?" } } },
    { "id": "A11", "cardType": "recall-output", "skillId": "dont-understand", "context": "The teacher says a long sentence and you're completely lost. Say so.", "target": "我听不懂。", "hints": ["Wǒ tīng…", "我听不… (Wǒ tīng bu…)"], "ext": { "lang": { "pinyin": "Wǒ tīng bu dǒng.", "literalGloss": "I listen-not-understand." } } },
    { "id": "A12", "cardType": "recall-output", "skillId": "say-again", "context": "You only caught half of the teacher's sentence. Ask them to say it again.", "target": "请再说一遍。", "hints": ["Qǐng zài…", "请再说… (Qǐng zài shuō…)"], "ext": { "lang": { "pinyin": "Qǐng zài shuō yí biàn.", "literalGloss": "Please again say one-time." } } },
    { "id": "A13", "cardType": "recall-output", "skillId": "speak-slower", "context": "Your partner talks way too fast for you. Ask them to slow down.", "target": "请说慢一点。", "hints": ["Qǐng shuō…", "请说慢… (Qǐng shuō màn…)"], "ext": { "lang": { "pinyin": "Qǐng shuō màn yìdiǎn.", "literalGloss": "Please speak slow a-little." } } },
    { "id": "A14", "cardType": "recall-output", "skillId": "im-hungry", "context": "It's noon and your roommate asks if you want to head out. Say you're hungry.", "target": "我饿了。", "hints": ["Wǒ…", "我饿… (Wǒ è…)"], "ext": { "lang": { "pinyin": "Wǒ è le.", "literalGloss": "I hungry (now)." } } },
    { "id": "A15", "cardType": "recall-output", "skillId": "wo-yao", "context": "The menu has pictures. Point at one and order it.", "target": "我要这个。", "hints": ["Wǒ yào…", "我要这… (Wǒ yào zhè…)"], "ext": { "lang": { "pinyin": "Wǒ yào zhège.", "literalGloss": "I want this-one." } } },
    { "id": "A16", "cardType": "recall-output", "skillId": "wo-yao", "context": "The server asks what you'd like to drink. Order a cup of tea.", "target": "我要一杯茶。", "hints": ["Wǒ yào…", "我要一杯… (Wǒ yào yì bēi…)"], "ext": { "lang": { "pinyin": "Wǒ yào yì bēi chá.", "literalGloss": "I want one cup tea." } } },
    { "id": "A17", "cardType": "recall-output", "skillId": "do-you-have", "context": "You just want plain rice. Ask if they have it.", "target": "有米饭吗？", "hints": ["Yǒu…", "有米饭… (Yǒu mǐfàn…)"], "ext": { "lang": { "pinyin": "Yǒu mǐfàn ma?", "literalGloss": "Have rice (ma)?" } } },
    { "id": "A18", "cardType": "recall-output", "skillId": "dont-eat", "context": "Your friend is ordering for the table, but you're vegetarian. Tell them.", "target": "我不吃肉。", "hints": ["Wǒ bù…", "我不吃… (Wǒ bù chī…)"], "ext": { "lang": { "pinyin": "Wǒ bù chī ròu.", "literalGloss": "I not eat meat." } } },
    { "id": "A19", "cardType": "recall-output", "skillId": "delicious", "context": "Your host asks how the dumplings are. They're great—say so.", "target": "很好吃！", "hints": ["Hěn…", "很好… (Hěn hǎo…)"], "ext": { "lang": { "pinyin": "Hěn hǎochī!", "literalGloss": "Very good-to-eat!" } } },
    { "id": "A20", "cardType": "recall-output", "skillId": "check-please-zh", "context": "Dinner is done and you want to pay. Call the server over.", "target": "服务员，买单！", "hints": ["Fúwùyuán…", "服务员，买… (Fúwùyuán, mǎi…)"], "ext": { "lang": { "pinyin": "Fúwùyuán, mǎidān!", "literalGloss": "Waiter, close-bill!" } } },
    { "id": "A21", "cardType": "recall-output", "skillId": "how-much-zh", "context": "At the night market, an item has no price tag. Ask the price.", "target": "这个多少钱？", "hints": ["Zhège…", "这个多少… (Zhège duōshao…)"], "ext": { "lang": { "pinyin": "Zhège duōshao qián?", "literalGloss": "This-one how-much money?" } } },
    { "id": "A22", "cardType": "recall-output", "skillId": "too-expensive", "context": "The vendor quotes triple the fair price. React.", "target": "太贵了！", "hints": ["Tài…", "太贵… (Tài guì…)"], "ext": { "lang": { "pinyin": "Tài guì le!", "literalGloss": "Too expensive (le)!" } } },
    { "id": "A23", "cardType": "recall-output", "skillId": "cheaper", "context": "You want to bargain politely. Ask for a bit cheaper.", "target": "便宜一点，好吗？", "hints": ["Piányi…", "便宜一点… (Piányi yìdiǎn…)"], "ext": { "lang": { "pinyin": "Piányi yìdiǎn, hǎo ma?", "literalGloss": "Cheap a-little, good (ma)?" } } },
    { "id": "A24", "cardType": "recall-output", "skillId": "want-to-buy", "context": "You walk into a corner store; the clerk asks what you need. You need water.", "target": "我想买水。", "hints": ["Wǒ xiǎng…", "我想买… (Wǒ xiǎng mǎi…)"], "ext": { "lang": { "pinyin": "Wǒ xiǎng mǎi shuǐ.", "literalGloss": "I want-to buy water." } } },
    { "id": "A25", "cardType": "recall-output", "skillId": "wo-yao", "context": "The bun vendor asks how many you want. You want two.", "target": "我要两个。", "hints": ["Wǒ yào…", "我要两… (Wǒ yào liǎng…)"], "ext": { "lang": { "pinyin": "Wǒ yào liǎng ge.", "literalGloss": "I want two (items)." } } },
    { "id": "A26", "cardType": "recall-output", "skillId": "ill-buy", "context": "After comparing two T-shirts, you've decided on this one.", "target": "我买这个。", "hints": ["Wǒ mǎi…", "我买这… (Wǒ mǎi zhè…)"], "ext": { "lang": { "pinyin": "Wǒ mǎi zhège.", "literalGloss": "I buy this-one." } } },
    { "id": "A27", "cardType": "recall-output", "skillId": "where-is", "context": "You're in a mall and need the restroom. Stop a staff member politely.", "target": "请问，洗手间在哪儿？", "hints": ["Qǐngwèn…", "请问，洗手间… (Qǐngwèn, xǐshǒujiān…)"], "ext": { "lang": { "pinyin": "Qǐngwèn, xǐshǒujiān zài nǎr?", "literalGloss": "Please-ask, wash-hand-room at where?" } } },
    { "id": "A28", "cardType": "recall-output", "skillId": "is-it-far", "context": "You're deciding whether to walk or take a cab to the subway. Ask if it's far from here.", "target": "地铁站离这儿远吗？", "hints": ["Dìtiězhàn…", "地铁站离这儿… (Dìtiězhàn lí zhèr…)"], "ext": { "lang": { "pinyin": "Dìtiězhàn lí zhèr yuǎn ma?", "literalGloss": "Subway-station from here far (ma)?" } } },
    { "id": "A29", "cardType": "recall-output", "skillId": "go-to-place", "context": "You get into a taxi at the hotel. Tell the driver your destination: the airport.", "target": "我要去机场。", "hints": ["Wǒ yào qù…", "我要去机… (Wǒ yào qù jī…)"], "ext": { "lang": { "pinyin": "Wǒ yào qù jīchǎng.", "literalGloss": "I want go airport." } } },
    { "id": "A30", "cardType": "recall-output", "skillId": "how-to-get", "context": "You need a bank; ask a passerby the way.", "target": "去银行怎么走？", "hints": ["Qù yínháng…", "去银行怎么… (Qù yínháng zěnme…)"], "ext": { "lang": { "pinyin": "Qù yínháng zěnme zǒu?", "literalGloss": "Go bank how walk?" } } },
    { "id": "A31", "cardType": "recall-output", "skillId": "right-here", "context": "The taxi is nearing your dorm gate. Tell the driver this is the spot.", "target": "就在这儿，谢谢！", "hints": ["Jiù zài…", "就在这儿… (Jiù zài zhèr…)"], "ext": { "lang": { "pinyin": "Jiù zài zhèr, xièxie!", "literalGloss": "Just at here, thanks!" } } },
    { "id": "A32", "cardType": "recall-output", "skillId": "confirm-bus", "context": "Before boarding, confirm with the driver that this bus goes to the airport.", "target": "这是去机场的车吗？", "hints": ["Zhè shì qù…", "这是去机场的… (Zhè shì qù jīchǎng de…)"], "ext": { "lang": { "pinyin": "Zhè shì qù jīchǎng de chē ma?", "literalGloss": "This is go-airport DE vehicle (ma)?" } } },
    { "id": "A33", "cardType": "recall-output", "skillId": "what-time", "context": "Your phone is dead and you need the time. Ask a classmate.", "target": "现在几点？", "hints": ["Xiànzài…", "现在几… (Xiànzài jǐ…)"], "ext": { "lang": { "pinyin": "Xiànzài jǐ diǎn?", "literalGloss": "Now how-many o'clock?" } } },
    { "id": "A34", "cardType": "recall-output", "skillId": "at-time-i", "context": "A friend suggests morning coffee; explain you have class at nine.", "target": "我九点上课。", "hints": ["Wǒ jiǔ diǎn…", "我九点上… (Wǒ jiǔ diǎn shàng…)"], "ext": { "lang": { "pinyin": "Wǒ jiǔ diǎn shàngkè.", "literalGloss": "I nine o'clock attend-class." } } },
    { "id": "A35", "cardType": "recall-output", "skillId": "free-tomorrow", "context": "You want to invite your tutor for extra practice. First check if they're free tomorrow.", "target": "你明天有时间吗？", "hints": ["Nǐ míngtiān…", "你明天有… (Nǐ míngtiān yǒu…)"], "ext": { "lang": { "pinyin": "Nǐ míngtiān yǒu shíjiān ma?", "literalGloss": "You tomorrow have time (ma)?" } } },
    { "id": "A36", "cardType": "recall-output", "skillId": "lets-together", "context": "Class just ended and it's lunchtime. Suggest eating together.", "target": "我们一起吃饭吧！", "hints": ["Wǒmen yìqǐ…", "我们一起吃… (Wǒmen yìqǐ chī…)"], "ext": { "lang": { "pinyin": "Wǒmen yìqǐ chīfàn ba!", "literalGloss": "We together eat-meal (ba)!" } } },
    { "id": "A37", "cardType": "recall-output", "skillId": "propose-time", "context": "You're pinning down the meeting time. Propose tomorrow at 3 pm and check it works.", "target": "明天下午三点，好吗？", "hints": ["Míngtiān xiàwǔ…", "明天下午三点… (Míngtiān xiàwǔ sān diǎn…)"], "ext": { "lang": { "pinyin": "Míngtiān xiàwǔ sān diǎn, hǎo ma?", "literalGloss": "Tomorrow afternoon three o'clock, good (ma)?" } } },
    { "id": "A38", "cardType": "recall-output", "skillId": "thanks", "context": "A stranger picks up the phone you dropped. Thank them.", "target": "谢谢你！", "hints": ["Xiè…", "谢谢… (Xièxie…)"], "ext": { "lang": { "pinyin": "Xièxie nǐ!", "literalGloss": "Thank you!" } } },
    { "id": "A39", "cardType": "recall-output", "skillId": "sorry-zh", "context": "You bump into someone on a crowded subway. Apologize.", "target": "对不起！", "hints": ["Duì…", "对不… (Duìbu…)"], "ext": { "lang": { "pinyin": "Duìbuqǐ!", "literalGloss": "(I) face-not-rise = sorry!" } } },
    { "id": "A40", "cardType": "recall-output", "skillId": "no-thanks", "context": "A street vendor keeps pushing souvenirs at you. Decline politely.", "target": "不用了，谢谢！", "hints": ["Búyòng…", "不用了… (Búyòng le…)"], "ext": { "lang": { "pinyin": "Búyòng le, xièxie!", "literalGloss": "Not-need (le), thanks!" } } },
    { "id": "A41", "cardType": "recall-output", "skillId": "can-you-help", "context": "Your suitcase is stuck in the subway gate. Ask the person behind you for help.", "target": "你能帮我吗？", "hints": ["Nǐ néng…", "你能帮… (Nǐ néng bāng…)"], "ext": { "lang": { "pinyin": "Nǐ néng bāng wǒ ma?", "literalGloss": "You can help me (ma)?" } } },
    { "id": "A42", "cardType": "recall-output", "skillId": "speak-a-little", "context": "A local asks 你会说中文吗? Answer honestly—you speak a little.", "target": "我会说一点中文。", "hints": ["Wǒ huì…", "我会说一点… (Wǒ huì shuō yìdiǎn…)"], "ext": { "lang": { "pinyin": "Wǒ huì shuō yìdiǎn Zhōngwén.", "literalGloss": "I can speak a-little Chinese." } } }
  ]
