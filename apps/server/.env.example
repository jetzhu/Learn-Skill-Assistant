# ---- BFF（MVP：仅 127.0.0.1，F8.7）----
PORT=8787
# 会话 Cookie 签名密钥（随机 32+ 字符）
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Microsoft 登录（F6）：Azure 应用注册 ----
# Entra 门户 → App registrations → New：
#   受支持账户类型：Personal Microsoft accounts（MVP 只支持个人账户，F7.2）
#   平台：Web，重定向 URI = http://localhost:5173/auth/microsoft/callback
#   （开发期浏览器只与 5173 交互，vite 将 /auth、/api 代理到本服务——Cookie 同源）
#   （无 client secret 时走公共客户端 PKCE：需在 Authentication 打开 Allow public client flows）
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# ---- Claude CLI Provider（F8.2：仅开发者本人自用）----
# 留空则自动探测 npm 全局安装位置
CLAUDE_EXE=
CLAUDE_MODEL=haiku
